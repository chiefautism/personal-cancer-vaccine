# Pipeline configuration
THREADS=4
MEMORY_GB=16

# Directories (relative to repo root)
REFERENCE_DIR=./references
DATA_DIR=./data
RESULTS_DIR=./results

# Tool versions
PVACTOOLS_VERSION=6.1.0
VEP_VERSION=113
GATK_VERSION=4.6.1.0
BWA_VERSION=0.7.17
SAMTOOLS_VERSION=1.19

# Sample info
TUMOR_SAMPLE=HCC1395_TUMOR_DNA
NORMAL_SAMPLE=HCC1395_NORMAL_DNA

# pVACseq parameters
EPITOPE_LENGTHS=8,9,10,11
BINDING_THRESHOLD=500
PERCENTILE_THRESHOLD=2
TOP_N=10
